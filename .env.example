# E-Hentai 账户 Cookie，必填
# 后续如果有更新，会自动更新覆写新的值进去，这里配置当前的就行
# 发送请求时 Cookie 必须包含 event 字段，值可以是任意数字，例如 event=111
E_COOKIE='hath_perks=xxx; ipb_member_id=123123; ipb_pass_hash=xxx; sk=xxx; event=111'
# 签到请求的代理，可留空。根据代理服务类型任选一种：
# HTTP：   E_PROXY='http://127.0.0.1:7890'
# HTTPS：  E_PROXY='https://127.0.0.1:7890'
# SOCKS5： E_PROXY='socks5://127.0.0.1:1080'（本地解析域名）
# SOCKS5： E_PROXY='socks5h://127.0.0.1:1080'（代理端解析域名）
# SOCKS4： E_PROXY='socks4://127.0.0.1:1080'（socks4a 由代理端解析域名）
E_PROXY=''
# User-Agent 可留空
E_USER_AGENT=''
# 通知配置是单行 JSON，可留空或使用 {} 关闭通知；下面是仅使用 Gotify 的示例
Notify='{"GOTIFY_URL":"https://gotify.example.com","GOTIFY_TOKEN":"YOUR_APP_TOKEN","GOTIFY_PRIORITY":5}'
# 多渠道示例：同一个 Notify 中同时填写 Gotify 和 Telegram 的字段，满足条件的渠道都会尝试发送
# 使用时请取消下一行的注释，并替换上面那行 Notify；不要同时保留多个 Notify 配置
# Notify='{"GOTIFY_URL":"https://gotify.example.com","GOTIFY_TOKEN":"YOUR_APP_TOKEN","GOTIFY_PRIORITY":5,"TG_BOT_TOKEN":"YOUR_BOT_TOKEN","TG_USER_ID":"YOUR_USER_ID"}'
# 其他渠道及其字段请查看 notify.py 的 push_config 和 README 的通知说明
# 每天的签到时间（系统本地时间），留空时默认为 00:30,12:30
# 24小时制格式（例：20:00,22:00）
E_SCHEDULE='00:30,12:30'
# 本地文件日志默认关闭；启用时写入 LOG_DIR/ehentai.log，控制台输出不受影响
LOG_ENABLED='false'
# 相对路径基于项目目录，也可以填写绝对路径
LOG_DIR='logs'
# 每个日志文件大小上限（MiB，正整数）和日志保留天数（正整数）
LOG_MAX_MB='5'
LOG_RETENTION_DAYS='30'
